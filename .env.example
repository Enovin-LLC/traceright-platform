# TraceRight Platform Environment Variables
# Copy this file to .env and fill in the values

# App Configuration
VITE_APP_ID=traceright-local
PORT=3000

# JWT Secret for session tokens (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database Configuration
# For MySQL production: mysql://user:password@host:3306/database
# Leave empty to use SQLite for local development
DATABASE_URL=

# OAuth Server Configuration (optional for local development)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=local-admin-user

# Forge API (optional)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Local Development Mode
# Set to "true" to enable local dev mode with mock auth
LOCAL_DEV_MODE=true
